# QaribuBot official website widget
# Docs: https://qaribubot.com/docs/install-the-widget
# Copy the exact values from QaribuBot dashboard -> Domains -> </> Code snippet.
# The pk_live_ key is a PUBLIC, domain-locked website key, not a secret token.
# Leave the key blank to disable the chatbot. Never commit a filled .env file.
PUBLIC_QARIBUBOT_API_KEY=
PUBLIC_QARIBUBOT_API_BASE=https://qaribubot.com
PUBLIC_QARIBUBOT_WIDGET_URL=https://qaribubot.com/widget.js

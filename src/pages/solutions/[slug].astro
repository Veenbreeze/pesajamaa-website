---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoPage from '../../components/InfoPage.astro';
import { solutionPages } from '../../data/module-pages';
import type { InfoPage as InfoPageData } from '../../data/types';

export function getStaticPaths() {
  return solutionPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
  page: InfoPageData;
}

const { page } = Astro.props;
---

<BaseLayout title={`${page.title} · PesaJamaa`} description={page.intro}>
  <InfoPage page={page} category="Solutions" categorySw="Ufumbuzi" />
</BaseLayout>

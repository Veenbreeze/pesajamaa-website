---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ModuleCard from '../components/ModuleCard.astro';
import FeatureRow from '../components/FeatureRow.astro';
import AudienceCard from '../components/AudienceCard.astro';
import StatCounter from '../components/StatCounter.astro';
import ProgressBar from '../components/ProgressBar.astro';
import LiveFeed from '../components/LiveFeed.astro';

/* ------------------------------------------------------------------
   Inline SVG icon helpers. Outline, 24x24, stroke currentColor so the
   tile colour shows through. Kept as strings so sections can loop over
   data and inject icons via <Fragment set:html={...} />.
   ------------------------------------------------------------------ */
const svg = (inner: string) =>
  `<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;

const icons = {
  pledge: svg('<path d="M12 21s-7-4.35-9.5-8.5C1 9.5 2.5 6 6 6c2 0 3.2 1.2 4 2.5C10.8 7.2 12 6 14 6c3.5 0 5 3.5 3.5 6.5C19 16.65 12 21 12 21Z"/>'),
  event: svg('<rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4M8 14h2m4 0h2"/>'),
  sms: svg('<path d="M21 11.5a7.5 7.5 0 0 1-10.9 6.7L3 20l1.8-5.3A7.5 7.5 0 1 1 21 11.5Z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"/>'),
  savings: svg('<path d="M3 10.5c0-2 2-3.5 5-3.5h4c3.5 0 6 2 6 5s-2.5 5-6 5H9l-3 2v-2.3A4.7 4.7 0 0 1 3 12.5Z"/><path d="M6.5 7V5.5M19 11h1.5"/>'),
  members: svg('<circle cx="9" cy="8" r="3"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0M16 5.2a3 3 0 0 1 0 5.6M18 20a5.5 5.5 0 0 0-3-4.9"/>'),
  payments: svg('<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 9.5h19M6 15h4"/>'),
  footprint: svg('<path d="M4 20V4M4 20h16M8 16l3-4 3 2 4-6"/>'),
  mobile: svg('<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>'),
  web: svg('<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M3 9h18M6.5 6.7h.01M9 6.7h.01"/>'),
  reports: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5M9 14v3m3-5v5m3-7v7"/>'),
  receipts: svg('<path d="M5 3v18l2-1.3 2 1.3 2-1.3 2 1.3 2-1.3 2 1.3V3l-2 1.3L15 3l-2 1.3L11 3 9 4.3 7 3Z"/><path d="M8.5 8h7M8.5 12h7"/>'),
  notifications: svg('<path d="M18 8.5a6 6 0 0 0-12 0c0 6-2.5 7.5-2.5 7.5h17S18 14.5 18 8.5Z"/><path d="M10 19.5a2 2 0 0 0 4 0"/>'),
};

const modules = [
  { label: 'Pledges', icon: icons.pledge, tint: 'rose' },
  { label: 'Events', icon: icons.event, tint: 'blue' },
  { label: 'Bulk SMS', icon: icons.sms, tint: 'teal' },
  { label: 'Group Savings', icon: icons.savings, tint: 'amber' },
  { label: 'Members', icon: icons.members, tint: 'violet' },
  { label: 'Payments', icon: icons.payments, tint: 'blue' },
  { label: 'Financial Footprint', icon: icons.footprint, tint: 'teal' },
  { label: 'Mobile App', icon: icons.mobile, tint: 'navy' },
  { label: 'Web Portal', icon: icons.web, tint: 'blue' },
  { label: 'Reports', icon: icons.reports, tint: 'amber' },
  { label: 'Receipts', icon: icons.receipts, tint: 'rose' },
  { label: 'Notifications', icon: icons.notifications, tint: 'violet' },
] as const;

/* Trust strip — telcos & banks (text wordmarks as soft gray cards) */
const partners = ['M-Pesa', 'Mixx by Yas', 'Airtel Money', 'HaloPesa', 'NMB Bank', 'CRDB Bank'];

/* Shared goals */
const goals = [
  { label: 'Church Building', value: 78_000_000, goal: 100_000_000, fill: 'accent' as const },
  { label: 'Wedding Fund', value: 8_200_000, goal: 10_000_000, fill: 'primary' as const },
  { label: 'School Project', value: 4_500_000, goal: 6_000_000, fill: 'accent' as const },
  { label: 'Investment Fund', value: 18_000_000, goal: 25_000_000, fill: 'primary' as const },
];

/* Audiences */
const audiences = [
  { title: 'Churches', line: 'Run building funds, tithes and offerings with full transparency.', icon: svg('<path d="M12 2v6M9 5h6M6 22v-9l6-4 6 4v9M9.5 22v-4a2.5 2.5 0 0 1 5 0v4"/>') },
  { title: 'Families', line: 'Coordinate family contributions for weddings, funerals and projects.', icon: svg('<circle cx="8" cy="8" r="2.5"/><circle cx="16" cy="8" r="2.5"/><path d="M3 19a5 5 0 0 1 10 0M11 19a5 5 0 0 1 10 0"/>') },
  { title: 'VICOBA / Chamas', line: 'Manage group savings and loans with a clear, shared ledger.', icon: svg('<path d="M3 10.5 12 5l9 5.5M5 10v8h14v-8M3 21h18"/>') },
  { title: 'Organizations', line: 'Keep membership dues and projects organised in one place.', icon: svg('<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h3M8 11h3M8 15h3M15 21v-5h3v5"/>') },
  { title: 'NGOs', line: 'Track donor pledges and show exactly where every shilling goes.', icon: svg('<path d="M12 21s-7-4.35-9.5-8.5C1 9.5 2.5 6 6 6c2 0 3.2 1.2 4 2.5C10.8 7.2 12 6 14 6c3.5 0 5 3.5 3.5 6.5C19 16.65 12 21 12 21Z"/>') },
  { title: 'Schools', line: 'Collect fees and project contributions from parents with receipts.', icon: svg('<path d="M12 4 2 9l10 5 10-5-10-5ZM6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5"/>') },
  { title: 'Investment Groups', line: 'Pool capital, track returns and keep members accountable.', icon: svg('<path d="M4 20V4M4 20h16M7 16l3-4 3 2 5-7"/>') },
  { title: 'Event Organizers', line: 'Sell tickets, track RSVPs and manage event budgets end to end.', icon: svg('<path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h15A1.5 1.5 0 0 1 21 8.5v2a2 2 0 0 0 0 4v2a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5v-2a2 2 0 0 0 0-4Z"/><path d="M14 7v10"/>') },
];

/* Ecosystem flow */
const flow = [
  { step: 'Create', line: 'Set up your group and goals in minutes.', icon: svg('<path d="M12 5v14M5 12h14"/>') },
  { step: 'Connect', line: 'Invite members by phone or SMS link.', icon: svg('<path d="M9 12a3 3 0 0 1 3-3h3a3 3 0 0 1 0 6M15 12a3 3 0 0 1-3 3H9a3 3 0 0 1 0-6"/>') },
  { step: 'Contribute', line: 'Members pay via mobile money or cash.', icon: svg('<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 9.5h19"/>') },
  { step: 'Engage', line: 'Send reminders and updates by bulk SMS.', icon: svg('<path d="M21 11.5a7.5 7.5 0 0 1-10.9 6.7L3 20l1.8-5.3A7.5 7.5 0 1 1 21 11.5Z"/>') },
  { step: 'Track', line: 'Watch progress with live reports.', icon: svg('<path d="M4 20V4M4 20h16M8 16l3-4 3 2 4-6"/>') },
  { step: 'Grow', line: 'Build a financial footprint that opens doors.', icon: svg('<path d="M3 17l6-6 4 4 8-8M15 7h6v6"/>') },
];

/* Why trust */
const whyTrust = [
  { title: 'Transparency You Can Show', line: 'Every contribution is recorded and visible to members, with no more disputes.', icon: svg('<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>') },
  { title: 'Fewer Bookkeeping Errors', line: 'Automatic totals and receipts replace error-prone paper lists.', icon: svg('<path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>') },
  { title: 'Clear Communication', line: 'Reach every member instantly with bulk SMS, even without smartphones.', icon: svg('<path d="M21 11.5a7.5 7.5 0 0 1-10.9 6.7L3 20l1.8-5.3A7.5 7.5 0 1 1 21 11.5Z"/>') },
  { title: 'Financial Inclusion', line: 'Give unbanked groups a credible, data-backed financial identity.', icon: svg('<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/>') },
];

/* Security */
const security = [
  { title: 'Protected Access', line: 'Role-based permissions keep sensitive data in the right hands.', icon: svg('<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 15v2"/>') },
  { title: 'Transparent Records', line: 'An immutable activity trail every member can review.', icon: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5M8 13h8M8 17h5"/>') },
  { title: 'Reliable Backups', line: 'Your group’s data is backed up automatically and safely stored.', icon: svg('<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.66 3.58 3 8 3s8-1.34 8-3V6M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/>') },
  { title: 'Real Support', line: 'A Tanzanian team ready to help your group by phone or chat.', icon: svg('<path d="M4 18v-6a8 8 0 0 1 16 0v6"/><path d="M4 16a2 2 0 0 1 2-2h1v6H6a2 2 0 0 1-2-2ZM20 16a2 2 0 0 0-2-2h-1v6h1a2 2 0 0 0 2-2Z"/>') },
];

/* Testimonials */
const testimonials = [
  { quote: 'Our building fund used to live on paper and WhatsApp. Now every member sees exactly what we’ve raised, and pledges have never been higher.', name: 'Pastor Emanuel M.', role: 'Church Leader, Dodoma' },
  { quote: 'Collecting VICOBA savings was chaos. PesaJamaa gives us one clean ledger and SMS reminders, so no one forgets their weekly share.', name: 'Asha R.', role: 'Chairperson, Mwanza Chama' },
  { quote: 'The receipts and monthly reports saved us hours and ended every “where did the money go?” argument in our group.', name: 'Daniel K.', role: 'Treasurer, Arusha Investment Group' },
];

/* Insights */
const insights = [
  { category: 'Guides', date: 'Oct 2026', read: '5 min', title: 'How to run a transparent church building fund', excerpt: 'A step-by-step playbook for collecting pledges and showing members where every shilling goes.' },
  { category: 'VICOBA', date: 'Sep 2026', read: '4 min', title: '5 ways SMS reminders boost group savings', excerpt: 'Simple nudges that keep chama members contributing on time, every cycle.' },
  { category: 'Inclusion', date: 'Sep 2026', read: '6 min', title: 'Building a financial footprint for your group', excerpt: 'Why a clear contribution history is the key to unlocking credit and growth.' },
];
---

<BaseLayout>
  <!-- ============================= HERO ============================= -->
  <section class="relative overflow-hidden">
    <!-- soft blue/teal wash -->
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-tint via-white to-white"></div>
    <div class="pointer-events-none absolute -left-24 -top-24 -z-10 h-80 w-80 rounded-full bg-primary/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-20 top-24 -z-10 h-96 w-96 rounded-full bg-accent/10 blur-3xl"></div>

    <div class="container-px grid items-center gap-12 py-16 lg:grid-cols-2 lg:gap-8 lg:py-24">
      <!-- Copy -->
      <div data-reveal>
        <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/70 px-3 py-1.5 text-xs font-bold text-slate shadow-soft">
          <span class="h-2 w-2 rounded-full bg-accent"></span>
          Community Finance &amp; Engagement, built for Tanzania
        </span>
        <h1 class="mt-5 text-4xl font-extrabold leading-[1.08] text-heading sm:text-5xl lg:text-[3.5rem]">
          One Platform to Run Your Community’s
          <span class="marker-underline text-accent">Finances</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
          From pledges to payments, PesaJamaa replaces paper lists and chat
          groups with one transparent platform, so your group can focus on its
          goals, not bookkeeping.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="#how-it-works" variant="primary" size="lg" pill>See How It Works</Button>
          <Button href="#final-cta" variant="secondary" size="lg" pill>Talk to an Advisor</Button>
        </div>
        <p class="mt-4 text-sm font-semibold text-muted">
          Free to get started, no credit card required.
        </p>
      </div>

      <!-- Product mockup -->
      <div class="relative" data-reveal>
        <!-- floating accent chips -->
        <div class="absolute -left-4 top-10 z-10 hidden animate-float rounded-2xl border border-slate-100 bg-white px-4 py-3 shadow-lift sm:block">
          <p class="text-xs font-bold text-muted">New pledge</p>
          <p class="text-sm font-extrabold text-accent">+ TZS 100,000</p>
        </div>
        <div class="absolute -right-3 bottom-16 z-10 hidden animate-float-slow rounded-2xl border border-slate-100 bg-white px-4 py-3 shadow-lift sm:block">
          <p class="text-xs font-bold text-muted">Members</p>
          <p class="text-sm font-extrabold text-primary">9,200+ active</p>
        </div>

        <!-- Dashboard card -->
        <div class="rounded-3xl border border-slate-100 bg-white p-5 shadow-lift">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-muted">Group dashboard</p>
              <p class="text-lg font-extrabold text-heading">Imani Community Group</p>
            </div>
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-tint text-primary">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 20V4M4 20h16M8 16l3-4 3 2 4-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-3">
            <div class="rounded-2xl bg-tint p-4">
              <p class="text-xs font-bold text-muted">Total raised</p>
              <p class="mt-1 text-xl font-extrabold text-heading">TZS 52.3M</p>
            </div>
            <div class="rounded-2xl bg-accent/10 p-4">
              <p class="text-xs font-bold text-muted">This month</p>
              <p class="mt-1 text-xl font-extrabold text-accent">+ TZS 6.1M</p>
            </div>
          </div>

          <div class="mt-4 rounded-2xl border border-slate-100 p-4">
            <div class="mb-2 flex items-center justify-between text-sm">
              <span class="font-bold text-heading">Church Building</span>
              <span class="font-bold text-accent">52%</span>
            </div>
            <div class="h-2.5 w-full overflow-hidden rounded-full bg-slate-100" data-progress="52">
              <div class="h-full w-0 rounded-full bg-gradient-to-r from-accent to-primary transition-[width] duration-1000 ease-out" data-progress-fill></div>
            </div>
            <div class="mt-4 space-y-2">
              <div class="flex items-center justify-between rounded-xl bg-gray-bg px-3 py-2">
                <span class="text-sm font-semibold text-heading">Mary K.</span>
                <span class="text-sm font-bold text-accent">+ TZS 50,000</span>
              </div>
              <div class="flex items-center justify-between rounded-xl bg-gray-bg px-3 py-2">
                <span class="text-sm font-semibold text-heading">Anonymous</span>
                <span class="text-sm font-bold text-accent">+ TZS 250,000</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= TRUST STRIP ============================= -->
  <section id="trust" class="border-y border-slate-100 bg-white py-12">
    <div class="container-px">
      <p class="text-center text-sm font-extrabold uppercase tracking-wider text-muted" data-reveal>
        Trusted by groups around Tanzania
      </p>
      <div class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6" data-reveal-stagger>
        {
          partners.map((p) => (
            <div class="flex items-center justify-center rounded-xl bg-gray-bg px-4 py-4 text-center text-[15px] font-extrabold text-slate/70 transition-colors hover:text-slate">
              {p}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================= MODULES GRID ============================= -->
  <section id="features" class="py-20">
    <div class="container-px">
      <SectionTitle
        eyebrow="Everything in one place"
        title="Our Community Finance Modules"
        subtitle="One platform covers the whole journey, from the first pledge to the monthly report."
      />
      <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" data-reveal-stagger>
        {
          modules.map((m) => (
            <ModuleCard label={m.label} tint={m.tint}>
              <Fragment set:html={m.icon} />
            </ModuleCard>
          ))
        }
      </div>
      <div class="mt-10 text-center" data-reveal>
        <Button href="#how-it-works" variant="ghost">View all modules →</Button>
      </div>
    </div>
  </section>

  <!-- ============================= STAT COUNTERS ============================= -->
  <section class="bg-gray-bg py-20">
    <div class="container-px">
      <div class="grid gap-10 sm:grid-cols-3">
        <StatCounter value={150} suffix="+" caption="Community Groups" />
        <StatCounter value={9200} suffix="+" caption="Active Members" />
        <StatCounter value={480} prefix="TZS " suffix="M+" caption="Pledges Tracked" />
      </div>
    </div>
  </section>

  <!-- ============== LIVE CONTRIBUTIONS SHOWCASE (signature) ============== -->
  <section id="showcase" class="relative overflow-hidden bg-navy py-20 text-white">
    <div class="pointer-events-none absolute -right-24 top-0 h-96 w-96 rounded-full bg-primary/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -left-24 bottom-0 h-96 w-96 rounded-full bg-accent/20 blur-3xl"></div>

    <div class="container-px">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="mb-3 text-sm font-extrabold uppercase tracking-wider text-accent">Live on PesaJamaa</p>
        <h2 class="text-3xl font-extrabold leading-tight text-white sm:text-4xl">
          Watch your community’s money move in real time
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-300">
          Every contribution appears the moment it lands, so members always see
          progress toward the goal.
        </p>
      </div>

      <div class="mx-auto mt-12 max-w-4xl rounded-3xl border border-white/10 bg-white p-5 text-left shadow-lift sm:p-8" data-reveal>
        <div class="grid gap-8 lg:grid-cols-2">
          <!-- Campaign side -->
          <div>
            <span class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-3 py-1 text-xs font-extrabold text-accent">
              Active campaign
            </span>
            <h3 class="mt-3 text-2xl font-extrabold text-heading">Build Our Church</h3>

            <div class="mt-5">
              <p class="text-sm font-bold text-muted">Raised</p>
              <p class="text-3xl font-extrabold text-heading sm:text-4xl">
                TZS <span data-countup="52350000" data-duration="2400">0</span>
              </p>
              <p class="mt-1 text-sm font-semibold text-muted">
                of TZS 100,000,000 goal
              </p>
            </div>

            <div
              class="mt-5 h-4 w-full overflow-hidden rounded-full bg-slate-100"
              data-progress="52"
              role="progressbar"
              aria-valuenow="52"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-label="Build Our Church: 52% of goal"
            >
              <div class="h-full w-0 rounded-full bg-gradient-to-r from-accent to-primary transition-[width] duration-[1600ms] ease-out" data-progress-fill></div>
            </div>

            <div class="mt-5 grid grid-cols-2 gap-3">
              <div class="rounded-2xl bg-tint p-4">
                <p class="text-2xl font-extrabold text-primary">52%</p>
                <p class="text-xs font-bold text-muted">of goal reached</p>
              </div>
              <div class="rounded-2xl bg-accent/10 p-4">
                <p class="text-2xl font-extrabold text-accent">
                  <span data-countup="1284" data-duration="2200">0</span>
                </p>
                <p class="text-xs font-bold text-muted">Contributions</p>
              </div>
            </div>

            <div class="mt-5 flex gap-3">
              <Button href="#final-cta" variant="primary" class="flex-1">Contribute</Button>
              <Button href="#final-cta" variant="secondary" class="flex-1">Share</Button>
            </div>
          </div>

          <!-- Live feed side -->
          <div class="rounded-2xl bg-gray-bg p-5">
            <LiveFeed />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= FEATURE ROWS ============================= -->
  <section id="how-it-works" class="py-20">
    <div class="container-px">
      <SectionTitle
        eyebrow="How it works"
        title="Real tools your group will actually use"
        subtitle="Each module is built for the way Tanzanian communities already organise and raise money."
      />

      <div class="mt-16 space-y-20">
        <!-- 1. Pledge & Event Management -->
        <FeatureRow
          label="Pledges & Events"
          title="Pledge & Event Management"
          description="Create a campaign or event, invite members, and track who has paid and who still owes, all without a single paper list."
          bullets={[
            'Paid / unpaid status for every member at a glance',
            'Event ticketing and RSVP tracking built in',
            'Automatic reminders for outstanding pledges',
          ]}
        >
          <!-- Mockup: pledge table -->
          <div class="rounded-3xl border border-slate-100 bg-white p-5 shadow-lift">
            <div class="flex items-center justify-between">
              <p class="font-extrabold text-heading">Harvest Pledges</p>
              <span class="rounded-full bg-tint px-3 py-1 text-xs font-bold text-primary">124 members</span>
            </div>
            <div class="mt-4 space-y-2 text-sm">
              {[
                ['John M.', 'TZS 100,000', 'Paid'],
                ['Mary K.', 'TZS 50,000', 'Paid'],
                ['Grace N.', 'TZS 75,000', 'Unpaid'],
                ['Peter S.', 'TZS 120,000', 'Paid'],
                ['Asha R.', 'TZS 40,000', 'Unpaid'],
              ].map(([name, amt, status]) => (
                <div class="flex items-center justify-between rounded-xl bg-gray-bg px-3 py-2.5">
                  <span class="font-semibold text-heading">{name}</span>
                  <div class="flex items-center gap-3">
                    <span class="font-bold text-heading">{amt}</span>
                    <span class={`rounded-full px-2.5 py-0.5 text-xs font-bold ${status === 'Paid' ? 'bg-accent/15 text-accent' : 'bg-rose-100 text-rose-600'}`}>{status}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </FeatureRow>

        <!-- 2. Bulk SMS -->
        <FeatureRow
          reverse

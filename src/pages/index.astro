---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ModuleCard from '../components/ModuleCard.astro';
import FeatureRow from '../components/FeatureRow.astro';
import AudienceCard from '../components/AudienceCard.astro';
import StatCounter from '../components/StatCounter.astro';
import ProgressBar from '../components/ProgressBar.astro';
import LiveFeed from '../components/LiveFeed.astro';
import AppDemo from '../components/AppDemo.astro';
import { insights } from '../data/insights';

/* ------------------------------------------------------------------
   Inline SVG icon helpers. Outline, 24x24, stroke currentColor so the
   tile colour shows through. Kept as strings so sections can loop over
   data and inject icons via <Fragment set:html={...} />.
   ------------------------------------------------------------------ */
const svg = (inner: string) =>
  `<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;

const icons = {
  pledge: svg('<path d="M12 21s-7-4.35-9.5-8.5C1 9.5 2.5 6 6 6c2 0 3.2 1.2 4 2.5C10.8 7.2 12 6 14 6c3.5 0 5 3.5 3.5 6.5C19 16.65 12 21 12 21Z"/>'),
  event: svg('<rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4M8 14h2m4 0h2"/>'),
  sms: svg('<path d="M21 11.5a7.5 7.5 0 0 1-10.9 6.7L3 20l1.8-5.3A7.5 7.5 0 1 1 21 11.5Z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"/>'),
  savings: svg('<path d="M3 10.5c0-2 2-3.5 5-3.5h4c3.5 0 6 2 6 5s-2.5 5-6 5H9l-3 2v-2.3A4.7 4.7 0 0 1 3 12.5Z"/><path d="M6.5 7V5.5M19 11h1.5"/>'),
  members: svg('<circle cx="9" cy="8" r="3"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0M16 5.2a3 3 0 0 1 0 5.6M18 20a5.5 5.5 0 0 0-3-4.9"/>'),
  payments: svg('<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 9.5h19M6 15h4"/>'),
  footprint: svg('<path d="M4 20V4M4 20h16M8 16l3-4 3 2 4-6"/>'),
  mobile: svg('<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>'),
  web: svg('<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M3 9h18M6.5 6.7h.01M9 6.7h.01"/>'),
  reports: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5M9 14v3m3-5v5m3-7v7"/>'),
  receipts: svg('<path d="M5 3v18l2-1.3 2 1.3 2-1.3 2 1.3 2-1.3 2 1.3V3l-2 1.3L15 3l-2 1.3L11 3 9 4.3 7 3Z"/><path d="M8.5 8h7M8.5 12h7"/>'),
  notifications: svg('<path d="M18 8.5a6 6 0 0 0-12 0c0 6-2.5 7.5-2.5 7.5h17S18 14.5 18 8.5Z"/><path d="M10 19.5a2 2 0 0 0 4 0"/>'),
};

const modules = [
  { label: 'Pledges', sw: 'Ahadi', description: 'Track member commitments and align payments around clear due dates.', descriptionSw: 'Fuatilia ahadi za wanachama na upangilie malipo kwenye tarehe zilizo wazi za kulipa.', icon: icons.pledge, tint: 'rose' },
  { label: 'Events', sw: 'Matukio', description: 'Plan fundraising campaigns and event budgets with one shared view.', descriptionSw: 'Panga kampeni za kukusanya fedha na bajeti za matukio kwa mtazamo mmoja wa pamoja.', icon: icons.event, tint: 'blue' },
  { label: 'Bulk SMS', sw: 'SMS za Wingi', description: 'Send reminders, updates and payment prompts to every member quickly.', descriptionSw: 'Tuma vikumbusho, taarifa na vidokezo vya malipo kwa kila mwanachama haraka.', icon: icons.sms, tint: 'teal' },
  { label: 'Group Savings', sw: 'Akiba ya Kikundi', description: 'Keep weekly or monthly savings organized and visible to everyone.', descriptionSw: 'Hifadhi akiba ya kila wiki au mwezi kwa mpangilio na kuonekana kwa kila mtu.', icon: icons.savings, tint: 'amber' },
  { label: 'Members', sw: 'Wanachama', description: 'Manage profiles, access and participation from one central register.', descriptionSw: 'Dhibiti wasifu, ufikiaji na ushiriki kutoka kwa rejista moja kuu.', icon: icons.members, tint: 'violet' },
  { label: 'Payments', sw: 'Malipo', description: 'Capture contributions and monitor incoming money without manual confusion.', descriptionSw: 'Kusanya michango na ufuatilia fedha zinazoingia bila mkanganyiko wa manu', icon: icons.payments, tint: 'blue' },
  { label: 'Financial Footprint', sw: 'Alama ya Kifedha', description: 'See the full story of where funds came from and where they went.', descriptionSw: 'Angalia hadithi nzima ya fedha zilikotoka na zilipoenda.', icon: icons.footprint, tint: 'teal' },
  { label: 'Mobile App', sw: 'Programu ya Simu', description: 'Give members a simple way to contribute from their phones anytime.', descriptionSw: 'Toa wanachama njia rahisi ya kuchangia kupitia simu zao wakati wowote.', icon: icons.mobile, tint: 'navy' },
  { label: 'Web Portal', sw: 'Portal ya Wavuti', description: 'Provide a secure dashboard for admins, leaders and members to review progress.', descriptionSw: 'Toa dashboard salama kwa wasimamizi, viongozi na wanachama kukagua maendeleo.', icon: icons.web, tint: 'blue' },
  { label: 'Reports', sw: 'Ripoti', description: 'Generate clean summaries for meetings, reviews and monthly updates.', descriptionSw: 'Tengeneza muhtasari safi kwa mikutano, ukaguzi na taarifa za kila mwezi.', icon: icons.reports, tint: 'amber' },
  { label: 'Receipts', sw: 'Risiti', description: 'Issue proof of payment instantly so every transaction stays trustworthy.', descriptionSw: 'Toa uthibitisho wa malipo papo hapo ili kila shughuli ibaki kuwa ya kuaminika.', icon: icons.receipts, tint: 'rose' },
  { label: 'Notifications', sw: 'Arifa', description: 'Keep everyone informed with reminders, milestones and urgent updates.', descriptionSw: 'Hakikisha kila mtu anafahamika kwa vikumbusho, hatua za maendeleo na taarifa za haraka.', icon: icons.notifications, tint: 'violet' },
] as const;

/* Trust strip — partner logos from public/partners */
const partners = [
  { name: 'Vodacom', file: 'vodacom.png' },
  { name: 'Yas', file: 'yas.png' },
  { name: 'Airtel', file: 'airtel.png' },
  { name: 'Halotel', file: 'halotel.png' },
  { name: 'NMB', file: 'nmb.png' },
  { name: 'CRDB', file: 'crdb.png' },
  { name: 'DTB', file: 'dtb.png' },
  { name: 'Stanbic', file: 'stanbic.png' },
  { name: 'NBC', file: 'nbc.svg' },
  { name: 'Selcom Pesa', file: 'selcompesa.png' },
  { name: 'Equity', file: 'equity.png' },
  { name: 'Azania', file: 'azania.png' },
];

/* Shared goals */
const goals = [
  { label: 'Church Building', sw: 'Ujenzi wa Kanisa', value: 78_000_000, goal: 100_000_000, fill: 'accent' as const },
  { label: 'Wedding Fund', sw: 'Mfuko wa Harusi', value: 8_200_000, goal: 10_000_000, fill: 'primary' as const },
  { label: 'School Project', sw: 'Mradi wa Shule', value: 4_500_000, goal: 6_000_000, fill: 'accent' as const },
  { label: 'Investment Fund', sw: 'Mfuko wa Uwekezaji', value: 18_000_000, goal: 25_000_000, fill: 'primary' as const },
];

/* Audiences */
const audiences = [
  { title: 'Churches', titleSw: 'Makanisa', line: 'Run building funds, tithes and offerings with full transparency.', lineSw: 'Endesha mifuko ya ujenzi, zaka na sadaka kwa uwazi kamili.', icon: svg('<path d="M12 2v6M9 5h6M6 22v-9l6-4 6 4v9M9.5 22v-4a2.5 2.5 0 0 1 5 0v4"/>') },
  { title: 'Families', titleSw: 'Familia', line: 'Coordinate family contributions for weddings, funerals and projects.', lineSw: 'Ratibu michango ya familia kwa harusi, misiba na miradi.', icon: svg('<circle cx="8" cy="8" r="2.5"/><circle cx="16" cy="8" r="2.5"/><path d="M3 19a5 5 0 0 1 10 0M11 19a5 5 0 0 1 10 0"/>') },
  { title: 'VICOBA / Chamas', titleSw: 'VICOBA / Chamas', line: 'Manage group savings and loans with a clear, shared ledger.', lineSw: 'Simamia akiba na mikopo ya kikundi kwa daftari wazi la pamoja.', icon: svg('<path d="M3 10.5 12 5l9 5.5M5 10v8h14v-8M3 21h18"/>') },
  { title: 'Organizations', titleSw: 'Mashirika', line: 'Keep membership dues and projects organised in one place.', lineSw: 'Weka ada za uanachama na miradi kwa mpangilio sehemu moja.', icon: svg('<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h3M8 11h3M8 15h3M15 21v-5h3v5"/>') },
  { title: 'NGOs', titleSw: 'NGOs', line: 'Track donor pledges and show exactly where every shilling goes.', lineSw: 'Fuatilia ahadi za wafadhili na onyesha kila shilingi inakoenda.', icon: svg('<path d="M12 21s-7-4.35-9.5-8.5C1 9.5 2.5 6 6 6c2 0 3.2 1.2 4 2.5C10.8 7.2 12 6 14 6c3.5 0 5 3.5 3.5 6.5C19 16.65 12 21 12 21Z"/>') },
  { title: 'Schools', titleSw: 'Shule', line: 'Collect fees and project contributions from parents with receipts.', lineSw: 'Kusanya ada na michango ya miradi kutoka kwa wazazi na risiti.', icon: svg('<path d="M12 4 2 9l10 5 10-5-10-5ZM6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5"/>') },
  { title: 'Investment Groups', titleSw: 'Vikundi vya Uwekezaji', line: 'Pool capital, track returns and keep members accountable.', lineSw: 'Changanya mtaji, fuatilia faida na uwajibishe wanachama.', icon: svg('<path d="M4 20V4M4 20h16M7 16l3-4 3 2 5-7"/>') },
  { title: 'Event Organizers', titleSw: 'Waandaji wa Matukio', line: 'Sell tickets, track RSVPs and manage event budgets end to end.', lineSw: 'Uza tiketi, fuatilia mahudhurio na simamia bajeti za matukio.', icon: svg('<path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h15A1.5 1.5 0 0 1 21 8.5v2a2 2 0 0 0 0 4v2a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5v-2a2 2 0 0 0 0-4Z"/><path d="M14 7v10"/>') },
];

/* Ecosystem flow */
const flow = [
  { step: 'Create', stepSw: 'Tengeneza', line: 'Set up your group and goals in minutes.', lineSw: 'Weka kikundi chako na malengo kwa dakika chache.', icon: svg('<path d="M12 5v14M5 12h14"/>') },
  { step: 'Connect', stepSw: 'Unganisha', line: 'Invite members by phone or SMS link.', lineSw: 'Alika wanachama kwa simu au kiungo cha SMS.', icon: svg('<path d="M9 12a3 3 0 0 1 3-3h3a3 3 0 0 1 0 6M15 12a3 3 0 0 1-3 3H9a3 3 0 0 1 0-6"/>') },
  { step: 'Contribute', stepSw: 'Changia', line: 'Members pay via mobile money or cash.', lineSw: 'Wanachama hulipa kupitia pesa za simu au taslimu.', icon: svg('<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 9.5h19"/>') },
  { step: 'Engage', stepSw: 'Shirikisha', line: 'Send reminders and updates by bulk SMS.', lineSw: 'Tuma vikumbusho na taarifa kwa SMS za wingi.', icon: svg('<path d="M21 11.5a7.5 7.5 0 0 1-10.9 6.7L3 20l1.8-5.3A7.5 7.5 0 1 1 21 11.5Z"/>') },
  { step: 'Track', stepSw: 'Fuatilia', line: 'Watch progress with live reports.', lineSw: 'Angalia maendeleo kwa ripoti za moja kwa moja.', icon: svg('<path d="M4 20V4M4 20h16M8 16l3-4 3 2 4-6"/>') },
  { step: 'Grow', stepSw: 'Kua', line: 'Build a financial footprint that opens doors.', lineSw: 'Jenga alama ya kifedha inayofungua milango.', icon: svg('<path d="M3 17l6-6 4 4 8-8M15 7h6v6"/>') },
];

/* Why trust */
const whyTrust = [
  { title: 'Transparency You Can Show', titleSw: 'Uwazi Unaoweza Kuonyesha', line: 'Every contribution is recorded and visible to members, with no more disputes.', lineSw: 'Kila mchango unarekodiwa na kuonekana na wanachama, bila migogoro tena.', icon: svg('<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>') },
  { title: 'Fewer Bookkeeping Errors', titleSw: 'Makosa Machache ya Uhasibu', line: 'Automatic totals and receipts replace error-prone paper lists.', lineSw: 'Jumla za kiotomatiki na risiti huondoa orodha za karatasi zenye makosa.', icon: svg('<path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>') },
  { title: 'Clear Communication', titleSw: 'Mawasiliano Wazi', line: 'Reach every member instantly with bulk SMS, even without smartphones.', lineSw: 'Fikia kila mwanachama papo hapo kwa SMS za wingi, hata bila simu janja.', icon: svg('<path d="M21 11.5a7.5 7.5 0 0 1-10.9 6.7L3 20l1.8-5.3A7.5 7.5 0 1 1 21 11.5Z"/>') },
  { title: 'Financial Inclusion', titleSw: 'Ujumuishwaji wa Kifedha', line: 'Give unbanked groups a credible, data-backed financial identity.', lineSw: 'Ipe vikundi visivyo na benki utambulisho wa kifedha wenye uhakika.', icon: svg('<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/>') },
];

/* Security */
const security = [
  { title: 'Protected Access', titleSw: 'Ufikiaji Uliolindwa', line: 'Role-based permissions keep sensitive data in the right hands.', lineSw: 'Ruhusa kulingana na majukumu huhakikisha data nyeti iko mikononi sahihi.', icon: svg('<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 15v2"/>') },
  { title: 'Transparent Records', titleSw: 'Kumbukumbu Wazi', line: 'An immutable activity trail every member can review.', lineSw: 'Historia ya shughuli isiyobadilika ambayo kila mwanachama anaweza kukagua.', icon: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5M8 13h8M8 17h5"/>') },
  { title: 'Reliable Backups', titleSw: 'Nakala za Uhakika', line: 'Your group’s data is backed up automatically and safely stored.', lineSw: 'Data ya kikundi chako huhifadhiwa kiotomatiki na kwa usalama.', icon: svg('<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.66 3.58 3 8 3s8-1.34 8-3V6M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/>') },
  { title: 'Real Support', titleSw: 'Msaada wa Kweli', line: 'A Tanzanian team ready to help your group by phone or chat.', lineSw: 'Timu ya Kitanzania tayari kukusaidia kwa simu au gumzo.', icon: svg('<path d="M4 18v-6a8 8 0 0 1 16 0v6"/><path d="M4 16a2 2 0 0 1 2-2h1v6H6a2 2 0 0 1-2-2ZM20 16a2 2 0 0 0-2-2h-1v6h1a2 2 0 0 0 2-2Z"/>') },
];

/* Testimonials */
const testimonials = [
  { quote: 'Our building fund used to live on paper and WhatsApp. Now every member sees exactly what we’ve raised, and pledges have never been higher.', quoteSw: 'Mfuko wetu wa ujenzi ulikuwa kwenye karatasi na WhatsApp. Sasa kila mwanachama anaona hasa tulichokusanya, na ahadi hazijawahi kuwa juu hivi.', name: 'Pastor Emanuel M.', role: 'Church Leader, Dodoma', roleSw: 'Kiongozi wa Kanisa, Dodoma' },
  { quote: 'Collecting VICOBA savings was chaos. PesaJamaa gives us one clean ledger and SMS reminders, so no one forgets their weekly share.', quoteSw: 'Kukusanya akiba za VICOBA kulikuwa vurugu. PesaJamaa inatupa daftari moja safi na vikumbusho vya SMS, hivyo hakuna anayesahau mchango wake wa wiki.', name: 'Asha R.', role: 'Chairperson, Mwanza Chama', roleSw: 'Mwenyekiti, Chama cha Mwanza' },
  { quote: 'The receipts and monthly reports saved us hours and ended every “where did the money go?” argument in our group.', quoteSw: 'Risiti na ripoti za kila mwezi zilituokolea masaa na kumaliza kila mgogoro wa "fedha zimeenda wapi?" kwenye kikundi chetu.', name: 'Daniel K.', role: 'Treasurer, Arusha Investment Group', roleSw: 'Mweka Hazina, Kikundi cha Uwekezaji Arusha' },
];

/* FAQ */
const faqs = [
  {
    q: 'Is my group’s money safe with PesaJamaa?',
    qSw: 'Je, fedha za kikundi changu ziko salama na PesaJamaa?',
    a: 'Yes. PesaJamaa records every transaction with role-based access, transparent records every member can review, and automatic backups. We never move your money ourselves; contributions go through trusted mobile-money and bank channels.',
    aSw: 'Ndiyo. PesaJamaa inarekodi kila muamala kwa ruhusa za majukumu, kumbukumbu wazi ambazo kila mwanachama anaweza kukagua, na nakala za kiotomatiki. Hatuhamishi fedha zako sisi wenyewe; michango hupita kwenye njia za kuaminika za pesa za simu na benki.',
  },
  {
    q: 'Do our members need smartphones?',
    qSw: 'Je, wanachama wetu wanahitaji simu janja?',
    a: 'No. Members can contribute via mobile money (USSD) and receive confirmations and reminders by SMS, so even members without smartphones stay fully included.',
    aSw: 'Hapana. Wanachama wanaweza kuchangia kupitia pesa za simu (USSD) na kupokea uthibitisho na vikumbusho kwa SMS, hivyo hata wasio na simu janja hujumuishwa kikamilifu.',
  },
  {
    q: 'How much does PesaJamaa cost?',
    qSw: 'PesaJamaa inagharimu kiasi gani?',
    a: 'You can get started for free, with no credit card required. As your group grows, flexible plans are available; talk to an advisor for what fits your group.',
    aSw: 'Unaweza kuanza bila malipo, bila kuhitaji kadi ya mkopo. Kikundi chako kinapokua, kuna mipango inayobadilika; zungumza na mshauri kupata inayofaa kikundi chako.',
  },
  {
    q: 'How do contributions come in?',
    qSw: 'Michango inaingiaje?',
    a: 'Through the mobile-money and bank channels your members already use (M-Pesa, Mixx by Yas, Airtel Money, HaloPesa, NMB, CRDB and more). Each payment is matched to the member and gets an instant receipt.',
    aSw: 'Kupitia njia za pesa za simu na benki ambazo wanachama wako tayari wanazitumia (M-Pesa, Mixx by Yas, Airtel Money, HaloPesa, NMB, CRDB na nyingine). Kila malipo huunganishwa na mwanachama na kupata risiti papo hapo.',
  },
  {
    q: 'Can we use PesaJamaa in Kiswahili?',
    qSw: 'Je, tunaweza kutumia PesaJamaa kwa Kiswahili?',
    a: 'Yes! The whole platform and this site work in both English and Kiswahili; switch anytime with the language button in the menu.',
    aSw: 'Ndiyo! Jukwaa zima na tovuti hii hufanya kazi kwa Kiingereza na Kiswahili; badilisha wakati wowote kwa kitufe cha lugha kwenye menyu.',
  },
  {
    q: 'How do we get started?',
    qSw: 'Tunaanzaje?',
    a: 'Click “Start Free” to create your group in minutes, or talk to an advisor and we’ll help you set everything up.',
    aSw: 'Bofya "Anza Bila Malipo" kutengeneza kikundi chako kwa dakika chache, au zungumza na mshauri nasi tutakusaidia kuweka kila kitu.',
  },
];
---

<BaseLayout>
  <!-- ============================= HERO ============================= -->
  <section class="relative overflow-hidden">
    <!-- soft blue/teal wash -->
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-tint via-white to-white"></div>
    <div class="pointer-events-none absolute -left-24 -top-24 -z-10 h-80 w-80 rounded-full bg-primary/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-20 top-24 -z-10 h-96 w-96 rounded-full bg-accent/10 blur-3xl"></div>

    <div class="container-px grid items-center gap-12 py-16 lg:grid-cols-2 lg:gap-8 lg:py-24">
      <!-- Copy -->
      <div data-reveal>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/70 px-3 py-1.5 text-xs font-bold text-slate shadow-soft"
          data-i18n
          data-en="Community Finance &amp; Engagement, built for Tanzania"
          data-sw="Fedha na Ushirikiano wa Jamii, kwa ajili ya Tanzania"
        >
          <span class="h-2 w-2 rounded-full bg-accent"></span>
          Community Finance &amp; Engagement, built for Tanzania
        </span>
        <h1 class="mt-5 text-4xl font-extrabold leading-[1.08] text-heading sm:text-5xl lg:text-[3.5rem]">
          <span data-i18n data-en="One Platform to Run Your Community’s" data-sw="Jukwaa Moja la Kuendesha">One Platform to Run Your Community’s</span>
          <span class="marker-underline text-accent" data-i18n data-en="Finances" data-sw="Fedha za Jamii Yako">Finances</span>
        </h1>
        <p
          class="mt-6 max-w-xl text-lg leading-relaxed text-muted"
          data-i18n
          data-en="From pledges to payments, PesaJamaa replaces paper lists and chat groups with one transparent platform, so your group can focus on its goals, not bookkeeping."
          data-sw="Kutoka kwa ahadi hadi malipo, PesaJamaa inachukua nafasi ya orodha za karatasi na vikundi vya gumzo kwa kutumia jukwaa moja la uwazi, ili kikundi chako kiweze kuzingatia malengo yake, si uhasibu wa karatasi."
        >
          From pledges to payments, PesaJamaa replaces paper lists and chat
          groups with one transparent platform, so your group can focus on its
          goals, not bookkeeping.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="#demo" variant="primary" size="lg" pill data-i18n data-en="See How It Works" data-sw="Tazama Inavyofanya Kazi">See How It Works</Button>
          <Button href="#final-cta" variant="secondary" size="lg" pill data-i18n data-en="Talk to an Advisor" data-sw="Zungumza na Mshauri">Talk to an Advisor</Button>
        </div>
        <p
          class="mt-4 text-sm font-semibold text-muted"
          data-i18n
          data-en="Free to get started, no credit card required."
          data-sw="Bila malipo kuanza, hakuna kadi ya mkopo inayohitajika."
        >
          Free to get started, no credit card required.
        </p>
      </div>

      <!-- Product mockup -->
      <div class="relative" data-reveal>
        <!-- floating accent chips -->
        <div class="absolute -top-14 right-6 z-10 hidden animate-float rounded-2xl border border-slate-100 bg-white px-4 py-3 shadow-lift lg:block">
          <p class="text-xs font-bold text-muted" data-i18n data-en="New pledge" data-sw="Ahadi mpya">New pledge</p>
          <p class="text-sm font-extrabold text-accent">+ TZS 100,000</p>
        </div>
        <div class="absolute -bottom-14 left-6 z-10 hidden animate-float-slow rounded-2xl border border-slate-100 bg-white px-4 py-3 shadow-lift lg:block">
          <p class="text-xs font-bold text-muted" data-i18n data-en="Members" data-sw="Wanachama">Members</p>

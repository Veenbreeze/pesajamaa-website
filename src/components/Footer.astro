---
/**
 * Footer — deep navy. The real logo has dark text, so it sits on a white
 * rounded chip here (never directly on the navy).
 */
const link = (label: string, labelSw: string, href: string) => ({ label, labelSw, href });

const socialLinks = [
  { label: 'PesaJamaa on Instagram', href: 'https://www.instagram.com/pesajamaa/', icon: 'instagram' },
  { label: 'PesaJamaa on YouTube', href: 'https://www.youtube.com/@pesajamaatanzania', icon: 'youtube' },
] as const;

const columns = [
  {
    title: 'Solutions',
    swTitle: 'Ufumbuzi',
    links: [
      link('Churches', 'Makanisa', '/solutions/churches'),
      link('VICOBA / Chamas', 'VICOBA / Chamas', '/solutions/vicoba-chamas'),
      link('NGOs', 'NGOs', '/solutions/ngos'),
      link('Event Organizers', 'Waandaji wa Matukio', '/solutions/event-organizers'),
      link('Schools', 'Shule', '/solutions/schools'),
    ],
  },
  {
    title: 'Features',
    swTitle: 'Vipengele',
    links: [
      link('Pledges', 'Ahadi', '/features/pledges'),
      link('Events', 'Matukio', '/features/events'),
      link('Bulk SMS', 'SMS za Wingi', '/features/bulk-sms'),
      link('Group Savings', 'Akiba ya Kikundi', '/features/group-savings'),
      link('Receipts', 'Risiti', '/features/receipts'),
    ],
  },
  {
    title: 'Tools',
    swTitle: 'Zana',
    links: [
      link('Web Portal', 'Portal ya Wavuti', '/tools/web-portal'),
      link('Android App', 'Programu ya Android', '/tools/android-app'),
      link('Reports', 'Ripoti', '/tools/reports'),
      link('Notifications', 'Arifa', '/tools/notifications'),
      link('Payments', 'Malipo', '/tools/payments'),
    ],
  },
  {
    title: 'Resources',
    swTitle: 'Rasilimali',
    links: [
      link('Insights', 'Maarifa', '/insights'),
      link('How it works', 'Inafanya kazi vipi', '/how-it-works'),
      link('Help Center', 'Kituo cha Usaidizi', '/help-center'),
      link('Guides', 'Mwongozo', '/guides'),
    ],
  },
  {
    title: 'Company',
    swTitle: 'Kampuni',
    links: [
      link('About', 'Kuhusu', '/about'),
      link('Careers', 'Kazi', '/careers'),
      link('Contact', 'Mawasiliano', '/contact'),
      link('Partners', 'Washirika', '/partners'),
    ],
  },
  {
    title: 'Legal',
    swTitle: 'Kisheria',
    links: [
      link('Privacy', 'Faragha', '/legal/privacy'),
      link('Terms', 'Masharti', '/legal/terms'),
      link('Security', 'Usalama', '/legal/security'),
      link('Cookies', 'Vidakuzi', '/legal/cookies'),
    ],
  },
];
---

<footer class="relative overflow-hidden bg-navy text-slate-300">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-leaf/70 to-transparent"></div>
  <div class="pointer-events-none absolute -left-32 -top-32 h-64 w-64 rounded-full bg-leaf/15 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-40 right-0 h-72 w-72 rounded-full bg-accent/10 blur-3xl"></div>
  <div class="container-px relative py-9 sm:py-11">
    <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] lg:gap-10">
      <!-- Brand block -->
      <div class="max-w-xs">
        <div class="clay-pill inline-flex rounded-xl bg-white p-1.5">
          <img src="/pesajamaa-logo.svg" alt="PesaJamaa" width="80" height="36" class="h-8 w-auto" />
        </div>
        <p
          class="mt-3 text-[13px] leading-relaxed text-slate-400"
          data-i18n
          data-en="One platform to run your community's finances: pledges, savings, events and reminders, all in one transparent place."
          data-sw="Jukwaa moja la kuendesha fedha za jamii yako: ahadi, akiba, matukio na vikumbusho, vyote kwenye sehemu moja ya uwazi."
        >
          One platform to run your community's finances: pledges, savings,
          events and reminders, all in one transparent place.
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <!-- Social icons -->
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                target="_blank"
                rel="noopener noreferrer"
                class="clay-dark flex h-9 w-9 items-center justify-center rounded-xl text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-leaf hover:shadow-glow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf-soft"
              >
                {social.icon === 'instagram' ? (
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.012-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069ZM12 0C8.741 0 8.332.014 7.052.072 2.695.272.273 2.69.073 7.052.014 8.332 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.332 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.668-.072-4.948-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0Zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z" /></svg>
                ) : (
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.016 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z" /></svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Link columns -->
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:gap-4">
        {
          columns.map((col) => (
            <div class="clay-dark rounded-xl px-3.5 py-3 transition-colors duration-200 hover:border-leaf/40">
              <h3
                class="text-[11px] font-extrabold uppercase tracking-wider text-white"
                data-i18n
                data-en={col.title}
                data-sw={col.swTitle}
              >
                <span class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-leaf"></span>{col.title}
              </h3>
              <ul class="mt-3 space-y-1.5">
                {col.links.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-[13px] text-slate-400 transition-all hover:translate-x-0.5 hover:text-leaf-soft"
                      data-i18n
                      data-en={item.label}
                      data-sw={item.labelSw}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="clay-dark-inset mt-7 flex flex-col items-center justify-between gap-3 rounded-xl px-4 py-3 sm:flex-row">
      <p
        class="text-xs text-slate-400"
        data-i18n
        data-en="© 2026 PesaJamaa. Designed, developed &amp; deployed with purpose."
        data-sw="© 2026 PesaJamaa. Imebuniwa, imejengwa na kusambazwa kwa madhumuni."
      >
        © 2026 PesaJamaa. Designed, developed &amp; deployed with purpose.
      </p>
      <p class="flex items-center gap-1.5 text-xs text-slate-400">
        <svg viewBox="0 0 24 16" class="h-3 w-4 rounded-[2px]" aria-hidden="true">
          <rect width="24" height="16" fill="#1EB53A" />
          <path d="M0 16 L0 12 L18 0 L24 0 L24 1 L4 16 Z" fill="#000" />
          <path d="M0 16 L0 15 L23 0 L24 0 L24 1 L1 16 Z" fill="#FCD116" />
        </svg>
        TZ
      </p>
    </div>
  </div>
</footer>

---
/**
 * Footer — deep navy. The real logo has dark text, so it sits on a white
 * rounded chip here (never directly on the navy).
 */
const columns = [
  {
    title: 'Solutions',
    links: ['Churches', 'VICOBA / Chamas', 'NGOs', 'Event Organizers', 'Schools'],
  },
  {
    title: 'Features',
    links: ['Pledges', 'Events', 'Bulk SMS', 'Group Savings', 'Receipts'],
  },
  {
    title: 'Tools',
    links: ['Web Portal', 'Android App', 'Reports', 'Notifications', 'Payments'],
  },
  {
    title: 'Resources',
    links: ['Insights', 'How it works', 'Help Center', 'Guides'],
  },
  {
    title: 'Company',
    links: ['About', 'Careers', 'Contact', 'Partners'],
  },
  {
    title: 'Legal',
    links: ['Privacy', 'Terms', 'Security', 'Cookies'],
  },
];
---

<footer class="bg-navy text-slate-300">
  <div class="container-px py-14">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_repeat(3,1fr)]">
      <!-- Brand block -->
      <div class="max-w-xs">
        <div class="inline-flex rounded-xl bg-white p-3 shadow-soft">
          <img src="/pesajamaa-logo.png" alt="PesaJamaa" width="150" height="43" class="h-8 w-auto" />
        </div>
        <p class="mt-5 text-[15px] leading-relaxed text-slate-400">
          One platform to run your community's finances: pledges, savings,
          events and reminders, all in one transparent place.
        </p>
        <div class="mt-5 flex items-center gap-3">
          <!-- Social icons -->
          <a href="#" aria-label="PesaJamaa on X" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-accent">
            <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" /></svg>
          </a>
          <a href="#" aria-label="PesaJamaa on Facebook" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-accent">
            <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987H7.898V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.891h-2.33v6.987C18.343 21.128 22 16.991 22 12Z" /></svg>
          </a>
          <a href="#" aria-label="PesaJamaa on Instagram" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-accent">
            <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.012-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069ZM12 0C8.741 0 8.332.014 7.052.072 2.695.272.273 2.69.073 7.052.014 8.332 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.332 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.668-.072-4.948-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0Zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z" /></svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-3">
        {
          columns.map((col) => (
            <div>
              <h3 class="text-sm font-extrabold uppercase tracking-wider text-white">{col.title}</h3>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a href="#" class="text-[15px] text-slate-400 transition-colors hover:text-accent">{link}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row">
      <p class="text-sm text-slate-400">
        © 2026 PesaJamaa. Designed, developed &amp; deployed with purpose.
      </p>
      <p class="flex items-center gap-1.5 text-sm text-slate-400">
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px]" aria-hidden="true">
          <rect width="24" height="16" fill="#1EB53A" />
          <path d="M0 16 L0 12 L18 0 L24 0 L24 1 L4 16 Z" fill="#000" />
          <path d="M0 16 L0 15 L23 0 L24 0 L24 1 L1 16 Z" fill="#FCD116" />
        </svg>
        Developed in Tanzania
      </p>
    </div>
  </div>
</footer>

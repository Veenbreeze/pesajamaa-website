---
/**
 * StatCounter — a big count-up number + caption. Animates on scroll
 * (see motion.js reading the data-countup attributes).
 */
interface Props {
  value: number;
  prefix?: string;
  suffix?: string;
  decimals?: number;
  caption: string;
}
const { value, prefix = '', suffix = '', decimals = 0, caption } = Astro.props;
---

<div class="text-center" data-reveal>
  <div
    class="bg-gradient-to-br from-primary to-accent bg-clip-text text-4xl font-extrabold tabular-nums text-transparent sm:text-5xl"
    data-countup={value}
    data-prefix={prefix}
    data-suffix={suffix}
    data-decimals={decimals}
  >
    {prefix}0{suffix}
  </div>
  <p class="mt-3 text-base font-semibold text-muted">{caption}</p>
</div>

---
/**
 * SectionTitle — eyebrow label + big heading + optional subtitle.
 * Centered by default; pass align="left" for left-aligned headers.
 */
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  class?: string;
  eyebrowEn?: string;
  eyebrowSw?: string;
  titleEn?: string;
  titleSw?: string;
  subtitleEn?: string;
  subtitleSw?: string;
}
const {
  eyebrow,
  title,
  subtitle,
  align = 'center',
  class: className = '',
  eyebrowEn,
  eyebrowSw,
  titleEn,
  titleSw,
  subtitleEn,
  subtitleSw,
} = Astro.props;

const wrap = align === 'center' ? 'text-center mx-auto max-w-2xl' : 'text-left max-w-2xl';
---

<div class={`${wrap} ${className}`} data-reveal>
  {
    eyebrow && (
      <p
        class="mb-3 text-sm font-extrabold uppercase tracking-wider text-accent"
        data-i18n
        data-en={eyebrowEn ?? eyebrow}
        data-sw={eyebrowSw ?? eyebrow}
      >
        {eyebrow}
      </p>
    )
  }
  <h2
    class="text-3xl leading-tight sm:text-4xl lg:text-[2.6rem]"
    data-i18n
    data-en={titleEn ?? title}
    data-sw={titleSw ?? title}
  >
    <Fragment set:html={title} />
  </h2>
  {
    subtitle && (
      <p
        class="mt-4 text-lg leading-relaxed text-muted"
        data-i18n
        data-en={subtitleEn ?? subtitle}
        data-sw={subtitleSw ?? subtitle}
      >
        {subtitle}
      </p>
    )
  }
</div>

---
/**
 * FeatureRow — alternating left/right feature block.
 * Text column: category label, heading, paragraph, 3-point checklist.
 * Visual column: a product-UI mockup passed in via the default slot.
 * Pass `reverse` to flip the image to the left on desktop.
 */
interface Props {
  label: string;
  title: string;
  description: string;
  bullets: string[];
  reverse?: boolean;
}
const { label, title, description, bullets, reverse = false } = Astro.props;
---

<div
  class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16"
  data-reveal
>
  <!-- Text -->
  <div class={reverse ? 'lg:order-2' : ''}>
    <span class="inline-block rounded-full bg-tint px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-primary">
      {label}
    </span>
    <h3 class="mt-4 text-2xl font-extrabold leading-tight text-heading sm:text-3xl">
      {title}
    </h3>
    <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>
    <ul class="mt-6 space-y-3">
      {
        bullets.map((b) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
              <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6.2 4.6 9 10 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="text-[15px] font-semibold text-heading">{b}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Visual / mockup -->
  <div class={reverse ? 'lg:order-1' : ''}>
    <slot />
  </div>
</div>

---
/**
 * ProgressBar — animated fill toward a shared goal.
 * `value`/`goal` compute the percentage; the fill width animates on scroll
 * (motion.js reads data-progress). `fill` picks the bar colour.
 * Pass `labelSw` for the language toggle ("of" also switches to "kati ya").
 */
interface Props {
  value: number;
  goal: number;
  label: string;
  labelSw?: string;
  format?: (n: number) => string;
  fill?: 'primary' | 'accent';
}
const { value, goal, label, labelSw, fill = 'accent' } = Astro.props;

const pct = Math.round((value / goal) * 100);
const fmt = (n: number) =>
  'TZS ' + n.toLocaleString('en-US', { maximumFractionDigits: 0 });

const fills: Record<string, string> = {
  primary: 'bg-gradient-to-r from-primary to-primary-hover',
  accent: 'bg-gradient-to-r from-accent to-primary',
};
---

<div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-soft" data-reveal>
  <div class="mb-3 flex items-baseline justify-between gap-3">
    <h3 class="text-base font-extrabold text-heading" data-i18n data-en={label} data-sw={labelSw ?? label}>{label}</h3>
    <span class="text-sm font-bold text-accent">{pct}%</span>
  </div>
  <div
    class="h-3 w-full overflow-hidden rounded-full bg-slate-100"
    data-progress={pct}
    role="progressbar"
    aria-valuenow={pct}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-label={`${label}: ${pct}%`}
  >
    <div
      class={`h-full w-0 rounded-full transition-[width] duration-1000 ease-out ${fills[fill]}`}
      data-progress-fill
    >
    </div>
  </div>
  <div class="mt-3 flex items-center justify-between text-sm">
    <span class="font-bold text-heading">{fmt(value)}</span>
    <span class="text-muted"><span data-i18n data-en="of" data-sw="kati ya">of</span> {fmt(goal)}</span>
  </div>
</div>

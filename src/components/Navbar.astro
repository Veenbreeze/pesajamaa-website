---
import Button from './Button.astro';

/**
 * Sticky top navigation.
 * Desktop: logo · nav with dropdowns · CTAs · "Developed in Tanzania" badge.
 * Mobile: logo · hamburger that opens a full panel.
 * Dropdowns open on hover AND keyboard focus (focus-within) on desktop,
 * and as expandable groups inside the mobile panel.
 */

const nav = [
  {
    label: 'Features',
    items: [
      { label: 'Pledges & Events', href: '#features' },
      { label: 'Bulk SMS', href: '#features' },
      { label: 'Group Savings', href: '#features' },
      { label: 'Receipts & Reports', href: '#features' },
    ],
  },
  {
    label: 'Solutions',
    items: [
      { label: 'Churches', href: '#audiences' },
      { label: 'VICOBA / Chamas', href: '#audiences' },
      { label: 'NGOs & Organizations', href: '#audiences' },
      { label: 'Event Organizers', href: '#audiences' },
    ],
  },
  {
    label: 'Pricing',
    items: [
      { label: 'Free to start', href: '#final-cta' },
      { label: 'Talk to an advisor', href: '#final-cta' },
    ],
  },
  {
    label: 'Resources',
    items: [
      { label: 'Latest insights', href: '#insights' },
      { label: 'How it works', href: '#ecosystem' },
      { label: 'Why trust us', href: '#trust' },
    ],
  },
];
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full border-b border-slate-100 bg-white/85 backdrop-blur-md transition-shadow"
>
  <nav class="container-px flex h-[72px] items-center justify-between" aria-label="Primary">
    <!-- Logo -->
    <a href="#top" class="flex shrink-0 items-center" aria-label="PesaJamaa home">
      <img
        src="/pesajamaa-logo.png"
        alt="PesaJamaa"
        width="156"
        height="45"
        class="h-9 w-auto"
      />
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 lg:flex">
      {
        nav.map((group) => (
          <li class="group relative">
            <button
              type="button"
              class="flex items-center gap-1 rounded-md px-3 py-2 text-[15px] font-bold text-heading transition-colors hover:text-primary focus-visible:text-primary"
              aria-expanded="false"
              aria-haspopup="true"
            >
              {group.label}
              <svg class="h-4 w-4 text-muted transition-transform group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.38a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
              </svg>
            </button>
            {/* Dropdown: shown on hover or keyboard focus within the group */}
            <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <ul class="w-60 rounded-xl border border-slate-100 bg-white p-2 shadow-lift">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="block rounded-lg px-3 py-2 text-[15px] font-semibold text-muted transition-colors hover:bg-tint hover:text-primary"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>

    <!-- Right side: badge + CTAs (desktop) -->
    <div class="hidden items-center gap-3 lg:flex">
      <span
        class="flex items-center gap-1.5 rounded-full bg-tint px-3 py-1.5 text-xs font-bold text-slate"
        title="Developed in Tanzania"
      >
        <!-- Tanzania flag -->
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px]" aria-hidden="true">
          <rect width="24" height="16" fill="#1EB53A" />
          <path d="M0 16 L24 0 L24 4 L6 16 Z" fill="#00A3DD" />
          <path d="M0 12 L18 0 L24 0 L0 16 Z" fill="#000" transform="translate(0,0)" />
          <path d="M0 16 L0 12 L18 0 L24 0 L24 1 L4 16 Z" fill="#000" />
          <path d="M0 16 L1 16 L24 1 L24 0 L23 0 L0 15 Z" fill="#FCD116" />
          <path d="M0 16 L0 15 L23 0 L24 0 L24 1 L1 16 Z" fill="#FCD116" />
        </svg>
        Developed in Tanzania
      </span>
      <Button href="#final-cta" variant="secondary">Talk to an Advisor</Button>
      <Button href="#final-cta" variant="primary">Start Free</Button>
    </div>

    <!-- Mobile hamburger -->
    <button
      type="button"
      id="menu-toggle"
      class="inline-flex items-center justify-center rounded-md p-2 text-heading lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white lg:hidden">
    <div class="container-px space-y-1 py-4">
      {
        nav.map((group) => (
          <details class="group rounded-lg">
            <summary class="flex cursor-pointer items-center justify-between rounded-lg px-3 py-3 text-[15px] font-bold text-heading marker:content-none">
              {group.label}
              <svg class="h-4 w-4 text-muted transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.38a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
              </svg>
            </summary>
            <ul class="space-y-0.5 pb-2 pl-3">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class="block rounded-lg px-3 py-2 text-[15px] font-semibold text-muted hover:text-primary" data-close-menu>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
      <div class="flex flex-col gap-2 pt-3">
        <Button href="#final-cta" variant="secondary" class="w-full">Talk to an Advisor</Button>
        <Button href="#final-cta" variant="primary" class="w-full">Start Free</Button>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle + header shadow on scroll.
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');

  function closeMenu() {
    if (!menu || !toggle) return;
    menu.classList.add('hidden');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
  }

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  // Close the mobile menu after tapping any in-page link.
  document.querySelectorAll('[data-close-menu]').forEach((el) =>
    el.addEventListener('click', closeMenu),
  );

  // Close on Escape for keyboard users.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // Subtle elevated shadow once the page is scrolled.
  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('shadow-soft', window.scrollY > 8);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

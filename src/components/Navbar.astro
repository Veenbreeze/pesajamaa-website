---
import Button from './Button.astro';

/**
 * Sticky top navigation.
 * Desktop: logo · nav with dropdowns · CTAs · "Developed in Tanzania" badge.
 * Mobile: logo · hamburger that opens a full panel.
 * Dropdowns open on hover AND keyboard focus (focus-within) on desktop,
 * and as expandable groups inside the mobile panel.
 */

const nav = [
  {
    label: 'Features',
    swLabel: 'Vipengele',
    items: [
      { label: 'Pledges & Events', swLabel: 'Ahadi na Matukio', href: '#features' },
      { label: 'Bulk SMS', swLabel: 'SMS za Wingi', href: '#features' },
      { label: 'Group Savings', swLabel: 'Akiba ya Kikundi', href: '#features' },
      { label: 'Receipts & Reports', swLabel: 'Risiti na Ripoti', href: '#features' },
    ],
  },
  {
    label: 'Solutions',
    swLabel: 'Ufumbuzi',
    items: [
      { label: 'Churches', swLabel: 'Makanisa', href: '#audiences' },
      { label: 'VICOBA / Chamas', swLabel: 'VICOBA / Chamas', href: '#audiences' },
      { label: 'NGOs & Organizations', swLabel: 'NGOs na Mashirika', href: '#audiences' },
      { label: 'Event Organizers', swLabel: 'Waandaji wa Matukio', href: '#audiences' },
    ],
  },
  {
    label: 'Pricing',
    swLabel: 'Bei',
    items: [
      { label: 'Free to start', swLabel: 'Bila malipo kuanza', href: '#final-cta' },
      { label: 'Talk to an advisor', swLabel: 'Zungumza na mshauri', href: '#final-cta' },
    ],
  },
  {
    label: 'Resources',
    swLabel: 'Rasilimali',
    items: [
      { label: 'See a demo', swLabel: 'Ona onyesho', href: '#demo' },
      { label: 'Latest insights', swLabel: 'Maarifa ya hivi karibuni', href: '#insights' },
      { label: 'FAQ', swLabel: 'Maswali', href: '#faq' },
      { label: 'Why trust us', swLabel: 'Kwa nini kutuamini', href: '#trust' },
    ],
  },
];
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full border-b border-slate-100 bg-white/85 backdrop-blur-md transition-shadow"
>
  <nav class="container-px flex h-20 items-center justify-between" aria-label="Primary">
    <!-- Logo -->
    <a href="#top" class="flex shrink-0 items-center" aria-label="PesaJamaa home">
      <img
        src="/pesajamaa-logo.svg"
        alt="PesaJamaa"
        width="122"
        height="56"
        class="h-14 w-auto"
      />
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 lg:flex">
      {
        nav.map((group) => (
          <li class="group relative">
            <button
              type="button"
              class="flex items-center gap-1 rounded-md px-3 py-2 text-[15px] font-bold text-heading transition-colors hover:text-primary focus-visible:text-primary"
              aria-expanded="false"
              aria-haspopup="true"
              data-i18n
              data-en={group.label}
              data-sw={group.swLabel}
            >
              {group.label}
              <svg class="h-4 w-4 text-muted transition-transform group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.38a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
              </svg>
            </button>
            {/* Dropdown: shown on hover or keyboard focus within the group */}
            <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <ul class="w-60 rounded-xl border border-slate-100 bg-white p-2 shadow-lift">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="block rounded-lg px-3 py-2 text-[15px] font-semibold text-muted transition-colors hover:bg-tint hover:text-primary"
                      data-i18n
                      data-en={item.label}
                      data-sw={item.swLabel}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>

    <!-- Right side: language + badge + CTAs (desktop) -->
    <div class="hidden items-center gap-3 lg:flex">
      <button
        id="language-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-extrabold uppercase tracking-wide text-slate transition-colors hover:border-primary hover:text-primary"
        aria-label="Switch language to Swahili"
      >
        SW
      </button>
      <span
        class="flex items-center gap-1.5 rounded-full bg-tint px-3 py-1.5 text-xs font-bold text-slate"
        title="Developed in Tanzania"
      >
        <!-- Tanzania flag -->
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px]" aria-hidden="true">
          <rect width="24" height="16" fill="#1EB53A" />
          <path d="M0 16 L24 0 L24 4 L6 16 Z" fill="#00A3DD" />
          <path d="M0 12 L18 0 L24 0 L0 16 Z" fill="#000" transform="translate(0,0)" />
          <path d="M0 16 L0 12 L18 0 L24 0 L24 1 L4 16 Z" fill="#000" />
          <path d="M0 16 L1 16 L24 1 L24 0 L23 0 L0 15 Z" fill="#FCD116" />
          <path d="M0 16 L0 15 L23 0 L24 0 L24 1 L1 16 Z" fill="#FCD116" />
        </svg>
        TZ
      </span>
      <Button href="#final-cta" variant="secondary" data-i18n data-en="Talk to an Advisor" data-sw="Zungumza na Mshauri">Talk to an Advisor</Button>
      <Button href="#final-cta" variant="primary" data-i18n data-en="Start Free" data-sw="Anza Bila Malipo">Start Free</Button>
    </div>

    <!-- Mobile hamburger -->
    <button
      type="button"
      id="menu-toggle"
      class="inline-flex items-center justify-center rounded-md p-2 text-heading lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white lg:hidden">
    <div class="container-px space-y-1 py-4">
      {
        nav.map((group) => (
          <details class="group rounded-lg">
            <summary class="flex cursor-pointer items-center justify-between rounded-lg px-3 py-3 text-[15px] font-bold text-heading marker:content-none">
              <span data-i18n data-en={group.label} data-sw={group.swLabel}>{group.label}</span>
              <svg class="h-4 w-4 text-muted transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.25 4.38a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
              </svg>
            </summary>
            <ul class="space-y-0.5 pb-2 pl-3">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class="block rounded-lg px-3 py-2 text-[15px] font-semibold text-muted hover:text-primary" data-close-menu data-i18n data-en={item.label} data-sw={item.swLabel}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
      <div class="flex flex-col gap-2 pt-3">
        <button
          id="mobile-language-toggle"
          type="button"
          class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold uppercase tracking-wide text-slate"
        >
          SW
        </button>
        <Button href="#final-cta" variant="secondary" class="w-full" data-i18n data-en="Talk to an Advisor" data-sw="Zungumza na Mshauri">Talk to an Advisor</Button>
        <Button href="#final-cta" variant="primary" class="w-full" data-i18n data-en="Start Free" data-sw="Anza Bila Malipo">Start Free</Button>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle + header shadow on scroll.
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');
  const languageToggle = document.getElementById('language-toggle');
  const mobileLanguageToggle = document.getElementById('mobile-language-toggle');

  const labels = {
    en: {
      toggle: 'SW',
      aria: 'Switch language to Swahili',
    },
    sw: {
      toggle: 'EN',
      aria: 'Badilisha lugha kuwa Kiingereza',
    },
  };

  let currentLang = 'en';

  const textNodes = document.querySelectorAll('[data-i18n]');

  const setI18nText = (el, nextText) => {
    const textNode = Array.from(el.childNodes).find(
      (node) => node.nodeType === Node.TEXT_NODE && node.textContent && node.textContent.trim(),
    );

    if (textNode) {
      textNode.textContent = nextText;
      return;
    }

    el.textContent = nextText;
  };

  const applyLanguage = (lang) => {
    currentLang = lang;
    const copy = labels[lang];

    textNodes.forEach((el) => {
      const nextText = el.getAttribute(lang === 'en' ? 'data-en' : 'data-sw');
      if (!nextText) return;

      const labelTarget = el.querySelector('[data-i18n-text]');
      if (labelTarget) {
        labelTarget.textContent = nextText;
        return;
      }

      setI18nText(el, nextText);
    });

    if (languageToggle) {
      languageToggle.textContent = copy.toggle;
      languageToggle.setAttribute('aria-label', copy.aria);
    }

    if (mobileLanguageToggle) {
      mobileLanguageToggle.textContent = copy.toggle;
      mobileLanguageToggle.setAttribute('aria-label', copy.aria);
    }

    document.documentElement.lang = lang;
  };

  const toggleLanguage = () => {
    applyLanguage(currentLang === 'en' ? 'sw' : 'en');
  };

  languageToggle?.addEventListener('click', toggleLanguage);
  mobileLanguageToggle?.addEventListener('click', toggleLanguage);

  function closeMenu() {
    if (!menu || !toggle) return;
    menu.classList.add('hidden');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
  }

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  // Close the mobile menu after tapping any in-page link.
  document.querySelectorAll('[data-close-menu]').forEach((el) =>
    el.addEventListener('click', closeMenu),
  );

  // Close on Escape for keyboard users.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // Subtle elevated shadow once the page is scrolled.
  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('shadow-soft', window.scrollY > 8);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

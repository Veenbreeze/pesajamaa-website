---
/**
 * Button — brand CTA. Renders an <a> when `href` is set, otherwise a <button>.
 * Variants: primary (solid blue), secondary (white + blue border), ghost,
 * light (for dark sections). Add `pill` for a fully rounded CTA.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'light' | 'leaf';
  size?: 'md' | 'lg';
  pill?: boolean;
  class?: string;
  type?: 'button' | 'submit';
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  pill = false,
  class: className = '',
  type = 'button',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-bold whitespace-nowrap transition-all duration-200 focus-visible:outline-none active:translate-y-0';
const clayBase = 'clay-button';
const clayPrimary = variant === 'primary' ? 'clay-button-primary' : variant === 'leaf' ? 'clay-button-leaf' : '';

const sizes = {
  md: 'px-5 py-2.5 text-[15px]',
  lg: 'px-7 py-3.5 text-base',
};

const variants = {
  primary:
    'bg-primary text-white hover:bg-primary-hover hover:-translate-y-0.5',
  secondary:
    'clay-pill text-primary ring-1 ring-inset ring-primary/35 hover:bg-white hover:-translate-y-0.5',
  ghost:
    'clay-pill text-primary hover:bg-white hover:-translate-y-0.5',
  light:
    'bg-white text-navy hover:-translate-y-0.5',
  leaf:
    'bg-leaf text-white hover:bg-leaf-hover hover:-translate-y-0.5',
};

const radius = pill ? 'rounded-full' : 'rounded-btn';
const cls = [base, clayBase, clayPrimary, sizes[size], variants[variant], radius, className].join(' ');
const Tag = href ? 'a' : 'button';
---

<Tag
  class={cls}
  {...(href ? { href } : { type })}
  {...rest}
>
  <slot />
</Tag>
